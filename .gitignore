
# Playwright
node_modules/
/test-results/
/playwright-report/
/playwright-report.zip
/blob-report/
/playwright/.cache/
.claude/skills/

# Environment variables - .env isn't strictly required here (the demo
# credentials have safe public fallbacks, see src/config/credentials.ts),
# but keep it out of git regardless in case it's ever used to point at a
# non-public OrangeHRM instance, or to hold a DISCORD_WEBHOOK_URL.
.env

# Point-in-time test-suite export (docs/OrangeHRM-Test-Suite.xlsx) - stale
# the moment a test is added or renamed; regenerate on demand instead of
# committing. the committed source is docs/test-suite/test-cases.json (see `pnpm docs:sync`).
docs/*.xlsx

# Archify diagrams: the JSON sources in docs/diagrams/sequence/ are committed;
# the generated HTML (about 740 KB each, plus Archify's evidence receipts) is
# rebuilt on demand with `pnpm diagrams`. .archify/ is Archify's scratch folder
# for one-off diagrams.
docs/diagrams/html/
docs/diagrams/all-tests.html
.archify/
