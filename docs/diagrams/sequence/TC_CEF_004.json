  "cards": [
    {
      "dot": "cyan",
      "title": "What it shows",
      "items": [
        "An employee is created together with a login (Disabled), then the test logs out and tries that login",
        "The result is the Account disabled error"
      ]
    },
    {
      "dot": "amber",
      "title": "Why waitForEmployeeSaved matters",
      "items": [
        "Logging out before the save finishes would try a user that does not exist yet",
        "The password always has a digit: the form refuses to save one without"
      ]
    },
    {
      "dot": "slate",
      "title": "Abridged on purpose",
      "items": [
        "Shows the calls that carry this test's meaning",
        "Assertion-only helpers and most browser echoes are left out",
        "Login, data creation and cleanup are shown in full in the three TC_UCF_001 diagrams"
      ]
    }
  ]
