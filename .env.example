# Copy this file to .env if you want to override the defaults below.
# .env is gitignored - it's not required to run the suite (see
# src/config/credentials.js for why these have safe fallbacks), but keeping
# overrides here instead of editing source is still good practice.

# OrangeHRM's public demo login - published by OrangeHRM itself, not a real
# secret. Defaults to Admin / admin123 if left unset.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Defaults to the public OrangeHRM demo instance if left unset. Override to
# point the suite at a different OrangeHRM instance.
BASE_URL=
