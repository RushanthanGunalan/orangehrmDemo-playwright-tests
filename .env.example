# Copy this file to .env if you want to override the defaults below.
# .env is gitignored - it's not required to run the suite (see
# src/config/credentials.js for why these have safe fallbacks), but keeping
# overrides here instead of editing source is still good practice.

# OrangeHRM's public demo login - published by OrangeHRM itself, not a real
# secret. Defaults to Admin / admin123 if left unset.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Defaults to the public OrangeHRM demo instance if left unset. Override to
# point the suite at a different OrangeHRM instance.
BASE_URL=

# Optional - the suite's "implicit wait" in ms: how long any element lookup,
# action, assertion or navigation waits before failing. Defaults to 60000.
# Raise it if the target instance is slower than the public demo.
WAIT_TIMEOUT_MS=

# Optional - posts a pass/fail summary (with the HTML report attached) to a
# Discord channel after `pnpm test:notify` or a CI run. Leave unset to skip
# the notification entirely (scripts/notify-discord.mjs no-ops without it).
# Create one via Discord: Server Settings > Integrations > Webhooks > New
# Webhook, then copy its URL here. On CI this is read from the repo's
# DISCORD_WEBHOOK_URL secret instead, never from this file.
DISCORD_WEBHOOK_URL=

# Optional - posts into this thread of the webhook's channel instead of the
# channel itself. Leave unset to post directly to the channel.
DISCORD_THREAD_ID=
